{
  "name": "Ai Display",
  "version": "2.1.7",
  "description": "AI Display helps you quickly find accurate answers and display relevant questions, making information discovery faster and smarter. (© elsesourav 2025)",
  "manifest_version": 3,
  "permissions": [
    "scripting",
    "storage",
    "activeTab",
    "tabs",
    "management",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "unlimitedStorage",
    "offscreen"
  ],
  "optional_permissions": ["clipboardWrite"],
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*",
    "*://www.google.com/*"
  ],
  "background": {
    "service_worker": "./background/background.js"
  },
  "homepage_url": "https://github.com/elsesourav",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_globs": ["chrome://*"],
      "run_at": "document_start",
      "all_frames": true,
      "js": [
        "./utils.js",
        "./content/enableCopy.js",
        "./content/content.js",
        "./content/menuContent.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "inject/*",
        "offscreen/*",
        "offscreen/OCR/*",
        "offscreen/OCR/Tesseract/*",
        "offscreen/OCR/Lang/*",
        "inject/selection.html",
        "inject/menuWindow.html",
        "offscreen/offscreen.html",
        "utils.js"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "assets/icons/16.png",
      "24": "assets/icons/24.png",
      "48": "assets/icons/48.png",
      "32": "assets/icons/32.png",
      "128": "assets/icons/128.png"
    },
    "default_title": "Ai Display",
    "default_popup": "./popup/popup.html"
  },
  "options_ui": {
    "page": "./options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icons/16.png",
    "24": "assets/icons/24.png",
    "48": "assets/icons/48.png",
    "32": "assets/icons/32.png",
    "128": "assets/icons/128.png"
  }
}
